  },
  "bugs": {
    "url": "https://github.com/cordiverse/capability/issues"
  },
  "homepage": "https://github.com/cordiverse/capability",
  "cordis": {
    "services": {
      "implements": [
        "capability"
      ]
    }
  },
  "peerDependencies": {
    "cordis": "^4.0.0-rc.6"
  },
  "devDependencies": {
    "cordis": "^4.0.0-rc.6"
